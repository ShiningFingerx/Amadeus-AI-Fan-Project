
{
  "name": "amadeus-ai-desktop",
  "version": "1.0.0",
  "description": "Amadeus AI Desktop Application",
  "main": "main.js",
  "homepage": ".",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron:start": "electron .",
    "electron:build": "npm run build && electron-builder",
    "generate-lore": "node scripts/generate-lore-data.js",
    "dev": "concurrently \"npm start\" \"wait-on http://localhost:3000 && npm run electron:start\""
  },
  "dependencies": {
    "@google/genai": "^1.34.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-scripts": "5.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^29.1.5",
    "electron-builder": "^24.13.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.amadeus.ai",
    "productName": "Amadeus AI",
    "extends": null,
    "files": [
      "build/**/*",
      "main.js",
      "preload.js"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
